import org.drools.model.codegen.execmodel.AccumulateTest.ControlFact;import org.drools.model.codegen.execmodel.AccumulateTest.Payment;rule r1
when
    Payment( $dueDate : dueDate)
    Number( longValue == $dueDate.getTime().getTime() ) from accumulate (      ControlFact( $todaysDate : todaysDate )      and
      Payment( $dueDate_acc : dueDate, eval($dueDate_acc.compareTo($todaysDate) <= 0) )
      ;max($dueDate_acc.getTime().getTime())
    )
then
end

