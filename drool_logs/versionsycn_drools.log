package org.drools.modelcompiler.drlx 

import java.time.LocalDate
import java.time.Month

rule "alternatives"
when
    a : null( /dates[year == 2021] )  
    b : null( /dates[year == 2023,dayOfMonth == 1,month == Month.JANUARY] )  
    (
    a : null( /dates[year == 2021] )  or
    b : null( /dates[year == 2023,dayOfMonth == 1,month == Month.JANUARY] )  or
    (
    c : null( /dates[year == 2024,dayOfMonth == 1,month == Month.JANUARY] )  and
    x : null( /dates[year == 2025] )  ) ) 
then
System.out.println("hello");

end

rule "year2020"
when
    foo : null( /dates[year > 2020] )  
then
{
    System.out.println("finally " + foo);
    int a = 1 + 1;
}

end

rule "newyear2020"
when
    foo : null( /dates[year == 2021,dayOfMonth == 1,month == Month.JANUARY] )  
then
{
    System.out.println("Happy new year 🎉 " + foo);
}

end

rule "join"
when
    a : null( /dates[year == 2021] )  
    b : null( /dates[year == a.year,dayOfMonth == 1,month == Month.JANUARY] )  
then
{
    System.out.println("Happy new year 🎉 " + b);
}

end



