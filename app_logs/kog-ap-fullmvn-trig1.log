CREATE FUNCTION spInsert_ComplexHierarchicalTypeMappingId() RETURNS trigger AS 
$$ 
BEGIN 
INSERT INTO ComplexHierarchicalTypeExtract 
  SELECT 
  NEW.var_name, 
  NEW.cache_name, 
  (NEW.json_value->>'root')\:\:text as root, 
  (NEW.json_value->'nestedBasic'->>'field3')\:\:text as nestedBasicMappedField, 
  (g0->>'root')\:\:text as nestedComplexCollectionMappedField1, 
  (g1->>'root')\:\:text as nestedComplexCollectionMappedSubField1
  FROM 
  jsonb_array_elements(
    case jsonb_typeof(NEW.json_value->'nestedComplexCollection') 
      when 'array' then NEW.json_value->'nestedComplexCollection' 
      else jsonb_build_array(NEW.json_value->'nestedComplexCollection')
    end
  ) g0, 
  jsonb_array_elements(
    case jsonb_typeof(g0->'nestedComplexCollection') 
      when 'array' then g0->'nestedComplexCollection' 
      else jsonb_build_array(g0->'nestedComplexCollection')
    end
  ) g1; 
RETURN NEW; 
END; 
$$ LANGUAGE PLPGSQL; 

