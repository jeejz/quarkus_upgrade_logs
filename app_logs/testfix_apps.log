CREATE FUNCTION spInsert_HierarchicalTypeMappingId() RETURNS trigger AS 
$$ 
BEGIN 
INSERT INTO HierarchicalTypeExtract 
  SELECT 
  NEW.var_name, 
  NEW.cache_name, 
  (NEW.json_value->>'root')\:\:text as root, 
  (NEW.json_value->'nestedBasic'->>'field3')\:\:text as nestedBasicMappedField, 
  (g0->>'field3')\:\:text as nestedBasicCollectionMappedField
  FROM 
  jsonb_array_elements(
    case jsonb_typeof(NEW.json_value->'nestedBasicCollection') 
      when 'array' then NEW.json_value->'nestedBasicCollection' 
      else jsonb_build_array(NEW.json_value->'nestedBasicCollection')
    end
  ) g0; 
RETURN NEW; 
END; 
$$ LANGUAGE PLPGSQL; 

