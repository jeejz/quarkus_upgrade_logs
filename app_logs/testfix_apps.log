CREATE FUNCTION spInsert_dynamicMappingId() RETURNS trigger AS 
$$ 
BEGIN 
INSERT INTO DynamicTypeExtract 
  SELECT 
  NEW.var_name, 
  NEW.cache_name, 
  (NEW.json_value->>'field1')\:\:text as field1MappedField, 
  (NEW.json_value->'field2')\:\:numeric as field2MappedField; 
RETURN NEW; 
END; 
$$ LANGUAGE PLPGSQL; 

